#!/bin/bash
#SBATCH --job-name=mforger            # Job name
#SBATCH --mail-type=none              # Mail events (NONE, BEGIN, END, FAIL, ALL)
#SBATCH -n 1                          # one task
#SBATCH -c 8                          # cores for mstool (OpenMM) and gmx mdrun
#SBATCH -N 1-1                        # single node
#SBATCH -p compute                    # partition: change to one of yours
#SBATCH --mem=70G                     # memory per node
#SBATCH --time=12:00:00               # Time limit hrs:min:sec
#SBATCH --output=mforger_%A_%a.log    # Standard output and error log
#
# One MembraneForger build per array task. CASES is a tab-separated file: name, all-atom PDB, coarse-grained file
# (and optionally extra command-line options in a fourth column, e.g. "--orient-chain R --nterm-side out" or
# "--pdb-id 7F6G --orient-chain R" for the membrane orientation). Use MEMBRANE as the all-atom entry to finish a
# system that is already all-atom.
#   sbatch --array=0-7 --export=ALL,REPO=/path/to/membraneforger,CASES=cases.tsv,OUTROOT=/path/to/outputs cpu.submit
# REPO is the folder that contains the membraneforger/ package. PY must import mstool, numpy, scipy and networkx;
# GMX is the GROMACS command.

: "${REPO:?set REPO to the repository folder}" "${CASES:?set CASES to the case table}" "${OUTROOT:?set OUTROOT to the output root}"
PY="${PY:-python}"
GMX="${GMX:-gmx}"

cd "$REPO" || exit 1
line=$(sed -n "$((SLURM_ARRAY_TASK_ID + 1))p" "$CASES")
name=$(cut -f1 <<<"$line"); aa=$(cut -f2 <<<"$line"); cg=$(cut -f3 <<<"$line"); extra=$(cut -f4 <<<"$line")
[ -n "$name" ] || { echo "no case on line $((SLURM_ARRAY_TASK_ID + 1)) of $CASES"; exit 1; }
echo "task $SLURM_ARRAY_TASK_ID $name host $(hostname) $(date '+%F %T')"
if [ "$aa" = "MEMBRANE" ]; then
    "$PY" -m membraneforger --membrane "$cg" --out "$OUTROOT/$name" --gmx "$GMX" \
        --ntomp "${SLURM_CPUS_PER_TASK:-8}" $extra
else
    "$PY" -m membraneforger --all-atom "$aa" --coarse-grain "$cg" --out "$OUTROOT/$name" \
        --gmx "$GMX" --ntomp "${SLURM_CPUS_PER_TASK:-8}" $extra
fi
