title		= S319A-MD 
; Run parameters
integrator	= md		; leap-frog integrator
nsteps		= 500000 ; 1ns   ; 25000000	; 2 * 5,000,000 = 10,000,000 ps (10 ns)
dt		= 0.002		; 2 fs
; tinit = 0 ; ??
; Output control
nstxout		= 1000		; save coordinates every 2 ps
nstvout		= 1000		; save velocities every 2 ps
nstxtcout	= 1000		; xtc compressed trajectory output every 2 ps
xtc-grps	= Protein_LIG
nstenergy	= 1000		; save energies every 2 ps
nstlog		= 1000		; update log file every 2 ps
; Bond parameters
continuation	= yes		; Restarting after NpT 
constraint_algorithm = lincs	; holonomic constraints 
constraints	= h-bonds	; all bonds (even heavy atom-H bonds) constrained
lincs_iter	= 1		; accuracy of LINCS
lincs_order	= 4		; also related to accuracy

; Neighborsearching
ns_type		= grid		; search neighboring grid cels
nstlist		= 12		; 10 fs
rlist		= 1.2		; short-range neighborlist cutoff (in nm)
rcoulomb	= 1.2		; short-range electrostatic cutoff (in nm)
rvdw		= 1.2		; short-range van der Waals cutoff (in nm)
cutoff-scheme	= Verlet

; Electrostatics
coulombtype	= PME		; Particle Mesh Ewald for long-range electrostatics
pme_order	= 4		; cubic interpolation
fourierspacing	= 0.16		; grid spacing for FFT

; Temperature coupling is on
tcoupl		= Nose-Hoover		; More accurate thermostat
tc-grps		= Protein_LIG  SOL_ION	; three coupling groups - more accurate
tau_t		= 0.5         0.5	; time constant, in ps
ref_t		= 310         310	; reference temperature, one for each group, in K

; Pressure coupling is OFF
pcoupl		= Parrinello-Rahman	; Use NVT ensemble, all P coupling terms are commented out
pcoupltype	= isotropic		; uniform scaling of x-y box vectors, independent z
tau_p		= 5.0			; time constant, in ps
ref_p		= 1.0	1.0		; reference pressure, x-y, z (in bar)
compressibility = 4.5e-5	4.5e-5	; isothermal compressibility, bar^-1

; Periodic boundary conditions
pbc		= xyz		; 3-D PBC
; Dispersion correction
DispCorr	= EnerPres	; account for cut-off vdW scheme

; Velocity generation
gen_vel		= no		; Velocity generation is off
;gen_temp	= 310		; Velocity generation is off
;gen_seed	= -1		; Velocity generation is off

; COM motion removal
; These options remove motion of the protein/bilayer relative to the solvent/ions
nstcomm         = 1 
comm-mode       = Linear
comm-grps       = Protein_LIG SOL_ION 

; Pull code
pull                    = yes
pull_ngroups            = 2
pull_ncoords            = 1
pull_group1_name        = flxloop
pull_group2_name        = actloop
pull_coord1_type        = umbrella      ; harmonic biasing force
pull_coord1_geometry    = distance      ; simple distance increase
pull_coord1_groups      = 1 2
;pull_coord1_dim         = N N Y
pull_coord1_rate        = -0.005          ; 0.01 nm per ps = 10 nm per ns
pull_coord1_k           = 1000          ; kJ mol^-1 nm^-2
pull_coord1_start       = yes           ; define initial COM distance > 0
pull-nstxout		= 100
pull-nstfout		= 100

